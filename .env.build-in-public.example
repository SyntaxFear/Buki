# Copy this file to .env.build-in-public.local and fill the secret values.
# The .local file is ignored by Git.

BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_X_CHANNEL_ID=
BUFFER_LINKEDIN_CHANNEL_ID=

# X is scheduled through the signed-in Brave tab. Setting this to buffer is an
# explicit legacy override and is not used by the weekly X automation.
BIP_X_TRANSPORT=brave

# Absolute path populated with immutable campaign media before deployment.
BIP_MEDIA_PUBLIC_DIR=
# Public HTTPS origin that serves BIP_MEDIA_PUBLIC_DIR without changing bytes.
BIP_MEDIA_BASE_URL=
# Optional JSON argv array, for example: ["npm","run","deploy:campaign-media"]
BIP_MEDIA_DEPLOY_COMMAND_JSON=

BIP_X_PROGRESS_PUBLISH_TIME=14:30
BIP_X_PUBLISH_TIME=18:00
BIP_LINKEDIN_PUBLISH_TIME=18:15

# Dedicated synthetic-only simulator used for weekly X media capture.
BIP_DISPOSABLE_SIMULATOR_UDID=83382C8C-B573-44BB-8DB6-CBFD6E24E608
BIP_DISPOSABLE_SIMULATOR_NAME=Buki-PageFlip-Debug-Disposable-20260813
# Current Debug-iphonesimulator Buki.app used after the app-only reset.
BIP_SIMULATOR_APP_PATH=
# Immutable app data container snapshot with .buki-synthetic-seed.json.
BIP_SIMULATOR_SEED_CONTAINER=
# Enables the local-only demo session while Metro serves the capture build.
EXPO_PUBLIC_BIP_SYNTHETIC_MODE=1

# Reddit requires explicitly approved Data API access and a user refresh token.
REDDIT_API_ACCESS_APPROVED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=
REDDIT_ACCOUNT_USERNAME=
# Shipaton's official app-business partner community. Live rules and flair are
# still checked before every write.
BIP_REDDIT_TARGETS_JSON={"D10":"AppBusiness","D20":"AppBusiness"}
# Map each approved subreddit to the SHA-256 printed by build-in-public:reddit-rules.
BIP_REDDIT_RULE_APPROVALS_JSON=
BIP_REDDIT_PUBLISH_TIME=18:30
