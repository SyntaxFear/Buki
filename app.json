{
  "expo": {
    "name": "Bloombook",
    "slug": "Bloombook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bloombook",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.parastashvili.bloombook",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EBE6DA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.parastashvili.bloombook",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EBE6DA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Bloombook uses the camera to scan drawings into your book."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bloombook opens your photo library so you can import a drawing photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d600782c-a339-4fe0-88da-2605d7c4bcdc"
      }
    },
    "owner": "parastashvili"
  }
}
