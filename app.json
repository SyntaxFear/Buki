{
  "expo": {
    "name": "Buki",
    "slug": "Bloombook",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buki",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.parastashvili.bloombook",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF5E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.parastashvili.bloombook",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#167D82",
          "image": "./assets/images/icon.png",
          "imageWidth": 230
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Buki uses the camera to scan drawings into your book."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Buki opens your photo library so you can import a drawing photo."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Buki accesses Photos only when an adult chooses artwork to import.",
          "savePhotosPermission": "Buki adds an exported artwork image to Photos only when an adult taps Save to Photos."
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d600782c-a339-4fe0-88da-2605d7c4bcdc"
      }
    },
    "owner": "parastashvili"
  }
}
