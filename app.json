{
  "expo": {
    "name": "Buki",
    "slug": "Bloombook",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buki",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.parastashvili.bloombook",
      "buildNumber": "35",
      "appStoreUrl": "https://apps.apple.com/app/id6798754626?action=write-review",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.parastashvili.buki.archive",
            "UTTypeDescription": "Buki Library Archive",
            "UTTypeConformsTo": [
              "public.zip-archive"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "buki"
              ],
              "public.mime-type": "application/vnd.buki.archive"
            }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF5E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.parastashvili.bloombook",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF5E5",
          "image": "./assets/images/buki-bear.png",
          "imageWidth": 220
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Buki uses the camera to scan drawings into your book.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Buki opens your photo library so you can import a drawing photo.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Buki uses Face ID to confirm an adult before purchases, exports, and account changes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Buki accesses Photos only when an adult chooses artwork to import.",
          "savePhotosPermission": "Buki adds an exported artwork image to Photos only when an adult taps Save to Photos."
        }
      ],
      "expo-apple-authentication",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d600782c-a339-4fe0-88da-2605d7c4bcdc"
      }
    },
    "owner": "parastashvili"
  }
}
